fedrgbd_venv/
venv/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# Data (large files — provide download links instead)
data/raw/*
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep

# Results (keep JSON results, ignore large files)
# results/ directory is tracked — contains experiment JSON outputs
# Uncomment below to ignore all results:
# results/*/

# Build artifacts
librealsense_build/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
tegrastats_*.txt

# Model checkpoints (large)
*.pt
*.pth
*.ckpt

# Temporary profiling files
/tmp/fedrgbd_power_*/

# Paper build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk

# Derived analysis outputs (scripts/analyze_results.py, analyze_flame_leakage.py)
analysis/**/hashes_*.npz
analysis/**/md5s.npz
# the sub-audits re-emit the same group files as analysis/leakage/ -- keep only their reports
analysis/leakage/v1_audit/groups.*
analysis/leakage/post_split_audit/groups.*
analysis/leakage/*/example_groups.txt

# Confidential correspondence (editor/reviewer e-mails) must never be committed
*.eml

# generated desktop baseline runner (scripts/print_revision_commands.py)
run_baselines_desktop.sh
logs/

# node hosts / users / paths for scripts/run_matrix.py (public repo: never commit)
configs/testbed.local.yaml
